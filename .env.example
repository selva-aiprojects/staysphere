# StaySphere Environment Configuration Template

# Runtime Environment
NODE_ENV=development
PORT=4000

# Database & Storage
DATABASE_URL="postgresql://staysphere:staysphere_secret@localhost:5432/staysphere_dev?schema=public"
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET="staysphere_super_secret_jwt_key_minimum_32_chars_long"
JWT_EXPIRES_IN="7d"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Payment Gateways (Sandbox / Test Mode)
RAZORPAY_KEY_ID="rzp_test_sampleKeyId"
RAZORPAY_KEY_SECRET="sampleKeySecret"
STRIPE_SECRET_KEY="sk_test_sampleStripeKey"
STRIPE_WEBHOOK_SECRET="whsec_sampleWebhookSecret"

# Communication & Notifications
SMS_PROVIDER="mock" # mock | twilio | gupshup
WHATSAPP_API_KEY="mock_whatsapp_key"
RESEND_API_KEY="re_mock_sampleKey"

# Maps & Geolocation
MAPS_API_KEY="mock_maps_api_key"
