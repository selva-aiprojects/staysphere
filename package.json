{
  "name": "staysphere-monorepo",
  "version": "3.0.0",
  "private": true,
  "description": "StaySphere — Hospitality Marketplace & Guest Journey Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "db:generate": "turbo run db:generate",
    "db:seed": "pnpm --filter @staysphere/database seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "prettier": "^3.5.3"
  },
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20.0.0"
  }
}
